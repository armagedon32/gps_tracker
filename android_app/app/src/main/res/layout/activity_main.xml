<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a2a3a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS Tracker"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ilagay ang pangalan ng device / sasakyan"
            android:textColor="#aab7c4"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hal. Tricycle #1"
            android:background="#22364a"
            android:textColor="#ffffff"
            android:textColorHint="#8fa3b5"
            android:padding="12dp"
            android:singleLine="true"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIMULAN ang pag-track"
            android:textColor="#ffffff"
            android:backgroundTint="#3498db"
            android:padding="14dp" />

        <Button
            android:id="@+id/sosBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🆘 SOS — IPADALA ANG TULONG"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:backgroundTint="#c0392b"
            android:padding="14dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hindi nagta-track."
            android:textColor="#aab7c4"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PAALALA: Pindutin ang 'SIMULAN' at iwan bukas ang app. Ang notification ay dapat HINDI i-swipe para patuloy ang pag-track. I-allow lahat ng pahintulot (permissions)."
            android:textColor="#8fa3b5"
            android:textSize="12sp"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>